#include "Student.h"
#include <iostream>

void searchFacult(student * arr, int size, std::string poiskFacult) {
	std::cout << "Search results by faculty: " << poiskFacult << std::endl;
	bool student = false;
	for (int i = 0; i < size; i++) {
		if (arr[i].getFacult() == poiskFacult) {
			std::cout << i + 1 << ". " << arr[i].getName() << " " << arr[i].getFam() << " " << arr[i].getOtch() << " Group: " << arr[i].getGroup() << " Avg. grade: " << arr[i].getYcpef() << std::endl;
			student = true;
		}
	}
	if (!student) {
		std::cout << "No such student found..." << std::endl;
	}
}

void searchYcpev(student* arr, int size, float poiskYcpef) {
	std::cout << "Search results by academic performance: " << poiskYcpef << std::endl;
	bool student = false;
	for (int i = 0; i < size; i++) {
		if (arr[i].getYcpef() >= poiskYcpef) {
			std::cout << i + 1 << ". " << arr[i].getName() << " " << arr[i].getFam() << " " << arr[i].getOtch() << " Group: " << arr[i].getGroup() << " Avg. grade: " << arr[i].getYcpef() << std::endl;
			student = true;
		}
	}
	if (!student) {
		std::cout << "No such student found..." << std::endl;
	}
}
